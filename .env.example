# URL del backend (FastAPI) a la que se conecta este frontend.
# Copiá este archivo como .env y cambiá el valor.
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
#
# IMPORTANTE: esta variable se lee al compilar (npm run build), no en caliente.
# Si cambiás el valor, hay que volver a compilar.

# Desarrollo local
VITE_API_URL=http://localhost:8000

# Producción (instancia AWS que hospeda el backend y la base de datos)
# VITE_API_URL=http://3.23.84.160:8000